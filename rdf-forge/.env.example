# =============================================================================
# RDF Forge - Environment Configuration Example
# =============================================================================
#
# Copy this file to .env and customize for your deployment:
#   cp .env.example .env
#
# IMPORTANT: .env is git-ignored. NEVER commit secrets.
# Defaults in docker-compose.yml (${VAR:-foo_dev_only}) are DEV ONLY. Any
# deployment beyond a local developer box MUST override every secret below.
#
# Deployment Modes:
#   1. Standalone (offline, single user):
#      docker compose -f docker-compose.standalone.yml up -d
#
#   2. Development (connect to external services):
#      docker compose -f docker-compose.development.yml up -d
#
#   3. Full stack (this file's compose):
#      docker compose up -d
#
# =============================================================================

# =============================================================================
# PORT CONFIGURATION (Windows-Safe Defaults)
# =============================================================================
# Note: Ports 8000-8010 can be reserved by Windows Hyper-V
# Using alternative ports to avoid conflicts

# Frontend UI port
UI_PORT=4200

# API Gateway port (external access)
GATEWAY_PORT=9080

# Infrastructure ports (standard)
GRAPHDB_PORT=7200
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=rdfforge
POSTGRES_USER=rdfforge
# Change before any non-local use.
POSTGRES_PASSWORD=rdfforge_dev_only

# For development mode - can point to remote database
# DATABASE_URL=jdbc:postgresql://remote-host:5432/rdfforge
# DATABASE_USER=remote_user
# DATABASE_PASSWORD=remote_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# Change before any non-local use.
REDIS_PASSWORD=rdfforge_redis_dev_only

# =============================================================================
# MINIO (S3-Compatible Storage) CONFIGURATION
# =============================================================================
MINIO_ROOT_USER=rdfforge
# Change before any non-local use.
MINIO_ROOT_PASSWORD=rdfforge_dev_only

# =============================================================================
# FUSEKI CONFIGURATION
# =============================================================================
# Change before any non-local use.
FUSEKI_ADMIN_PASSWORD=admin_dev_only

# =============================================================================
# GRAPHDB CONFIGURATION
# =============================================================================
GDB_HEAP_SIZE=2g

# =============================================================================
# SPRING PROFILES
# =============================================================================
# Available profiles:
#   - noauth: Disable authentication
#   - graphdb: Use GraphDB as triplestore
#   - fuseki: Use Apache Jena Fuseki as triplestore
#
# Standalone mode (no auth, GraphDB):
SPRING_PROFILES=noauth,graphdb

# Production mode (with auth, GraphDB):
# SPRING_PROFILES=graphdb

# =============================================================================
# AUTHENTICATION CONFIGURATION (Optional)
# =============================================================================
# Enable authentication
AUTH_ENABLED=false

# Keycloak configuration (when AUTH_ENABLED=true)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rdfforge
KEYCLOAK_CLIENT_ID=rdf-forge-ui
JWT_ISSUER_URI=http://keycloak:8080/realms/rdfforge

# Keycloak bootstrap admin (DEV ONLY — production MUST override via
# KC_BOOTSTRAP_ADMIN_USERNAME / KC_BOOTSTRAP_ADMIN_PASSWORD on first boot).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only

# Confidential client secret for the gateway. Generate a random value in
# Keycloak admin and put it here; NEVER reuse the example value.
KEYCLOAK_CLIENT_SECRET=replace_with_random_dev_only

# Initial demo-user passwords seeded by the realm-export user-creation script
# (docker/keycloak-users.sh). Remove both users in production.
KEYCLOAK_DEMO_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_DEMO_USER_PASSWORD=user_dev_only

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GRAFANA_ADMIN_USER=admin
# Change before any non-local use.
GRAFANA_ADMIN_PASSWORD=admin_dev_only

# =============================================================================
# DEVELOPMENT MODE - REMOTE SERVICE CONFIGURATION
# =============================================================================
# Use these when connecting to external Kubernetes cluster or remote services

# Remote API Gateway (overrides local gateway)
# REMOTE_API_URL=https://api.k8s.example.com

# Remote Service URLs (when gateway routes to external services)
# PIPELINE_SERVICE_URL=https://pipeline.k8s.example.com
# SHACL_SERVICE_URL=https://shacl.k8s.example.com
# JOB_SERVICE_URL=https://job.k8s.example.com
# DATA_SERVICE_URL=https://data.k8s.example.com
# DIMENSION_SERVICE_URL=https://dimension.k8s.example.com
# TRIPLESTORE_SERVICE_URL=https://triplestore.k8s.example.com

# =============================================================================
# UI BUILD CONFIGURATION
# =============================================================================
# Build configuration for Angular UI
# Options: standalone, development, production
UI_BUILD_CONFIG=standalone

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# WARNING: Change all passwords before deploying to production!
#
# Example production settings:
# POSTGRES_PASSWORD=<strong-random-password>
# MINIO_ROOT_PASSWORD=<strong-random-password>
# GDB_HEAP_SIZE=4g
#
# External URLs for production:
# EXTERNAL_API_URL=https://api.rdfforge.example.com
# EXTERNAL_UI_URL=https://rdfforge.example.com