      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} - {{action}} ({{cause}})",
          "refId": "A"
        }
      ],
      "title": "GC Collection Frequency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
