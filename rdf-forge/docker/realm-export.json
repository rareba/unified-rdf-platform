{
  "_comment": "DEV realm seed. Users carry NO passwords and client carries NO secret: both are set post-import by docker/keycloak-users.sh using env vars (see docker/README_SECURITY.md). Never add plaintext passwords or client secrets to this file.",
  "realm": "rdfforge",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "user",
        "description": "User role"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@rdfforge.io",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [],
      "realmRoles": [
        "admin",
        "user"
      ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@rdfforge.io",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [],
      "realmRoles": [
        "user"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "rdf-forge-ui",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:4200"
      ],
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "rdf-forge-gateway",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ]
}
